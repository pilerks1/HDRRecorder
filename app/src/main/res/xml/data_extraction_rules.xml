<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 and higher. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Storage-folder URIs are useless without their SAF grants, which are never restored. -->
        <exclude domain="sharedpref" path="hdr_recorder_prefs.xml" />
        <!-- Compatibility reports describe the original device only. -->
        <exclude domain="file" path="compatibility/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hdr_recorder_prefs.xml" />
        <exclude domain="file" path="compatibility/" />
    </device-transfer>
</data-extraction-rules>
